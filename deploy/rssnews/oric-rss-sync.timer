[Unit]
Description=Synchro quotidienne des actualites BBS Oric <- flux RSS/Atom externe

[Timer]
# Tous les jours vers 06:45 (heure locale de l'hote), avec dispersion aleatoire.
# Decale de la synchro tachibana (06:15) pour ne pas se chevaucher.
OnCalendar=*-*-* 06:45:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
